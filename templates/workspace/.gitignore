# OS / IDE
.DS_Store
.idea/
*.iml

# Build output and caches (every stack)
node_modules/
dist/
build/
.gradle/
.kotlin/
local.properties
coverage/
# (do not ignore `reports/` or similar folders that hold committed sources — a lost admin reports module came from exactly that)
*.log
__pycache__/
*.pyc

# Secrets and archives: never committed (rules §3.8)
.env
.env.*
!.env.example
*.zip
*.keystore
*.jks
*.p12
*.mobileprovision
*firebase-adminsdk*.json
*service-account*.json
# Real Firebase client files live outside git when they carry live keys; committed placeholders must build with Firebase off.
Local.xcconfig

# Agent worktrees (one per parallel agent) and nested git backups
.claude/worktrees/
.nested-git-backup/

# Hosted DEV environment of __SYSTEM_NAME__ (__DEV_API_URL__). Same rules as production
# (NODE_ENV=production refuses fakes), with dev databases, dev secrets and dev adapter accounts.
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
CORS_ALLOWED_ORIGINS=REPLACE_ME
MONGODB_URI=REPLACE_ME
REDIS_URL=REPLACE_ME
JWT_ACCESS_SECRET=REPLACE_ME
FIELD_ENCRYPTION_KEY=REPLACE_ME
OTP_PROVIDER=real
STORAGE_PROVIDER=real
NOTIFIER_PROVIDER=real
PAYMENT_PROVIDER=disabled
ANALYTICS_PROVIDER=real
OTP_CODE_SECRET=REPLACE_ME
OTP_PROOF_SECRET=REPLACE_ME
# Development data on the hosted dev database (never on production).
SEED_DEV_ON_START=false

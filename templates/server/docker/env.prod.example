# PRODUCTION environment of __SYSTEM_NAME__ (__PROD_API_URL__). Enter every key in the host's
# environment / secret store, never in git. Check a copy first (names only, never values):
#   npm run build && npm run env:check -- <your file>
NODE_ENV=production
LOG_LEVEL=info
# Number of proxies in front of the server (one load balancer = 1).
TRUST_PROXY_HOPS=1
# Browser origins allowed to call the API (the admin panel), comma separated.
CORS_ALLOWED_ORIGINS=REPLACE_ME
MONGODB_URI=REPLACE_ME
REDIS_URL=REPLACE_ME
# Signs login tokens. Run: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_ME
# Encrypts sensitive fields at rest. Run: openssl rand -base64 32. Never change it later.
FIELD_ENCRYPTION_KEY=REPLACE_ME
# Production runs on the real adapters only (src/providers/<name>/real.ts).
OTP_PROVIDER=real
STORAGE_PROVIDER=real
NOTIFIER_PROVIDER=real
PAYMENT_PROVIDER=disabled
ANALYTICS_PROVIDER=real
# Two different secrets, each from: openssl rand -base64 48
OTP_CODE_SECRET=REPLACE_ME
OTP_PROOF_SECRET=REPLACE_ME
SEED_DEV_ON_START=false

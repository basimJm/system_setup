# Copy to __SERVER_DIR__/.env.development (git-ignored) for local work. Fake providers need no accounts.
# Check any env file before booting: npm run build && npm run env:check -- .env.development
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://localhost:27017/__SYSTEM_SLUG__?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
# At least 32 characters; generate your own: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me
OTP_PROVIDER=fake
# Dev only: every OTP code is this value (codes are recorded, not sent, with the fake provider).
OTP_FIXED_CODE=123456
STORAGE_PROVIDER=fake
NOTIFIER_PROVIDER=fake
PAYMENT_PROVIDER=fake
ANALYTICS_PROVIDER=fake

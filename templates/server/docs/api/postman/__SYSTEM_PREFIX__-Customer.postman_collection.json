            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/customer/v1/auth/change-phone",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer",
                "v1",
                "auth",
                "change-phone"
              ],
              "query": [],
              "variable": []
            },
            "description": "Needs an `otpToken` (purpose CHANGE_PHONE) of the NEW number. Errors: `OTP_INVALID`, `OTP_EXPIRED`, `OTP_BLOCKED`, `PHONE_ALREADY_REGISTERED`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"string\",\n  \"otpToken\": \"string\"\n}",
              "options": {

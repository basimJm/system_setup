  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send an OTP code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/v1/auth/otp/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer",
                "v1",
                "auth",
                "otp",
                "request"
              ],
              "query": [],
              "variable": []
            },
            "description": "Public. The platform limits run first (`otp.maxRequests` per `otp.requestWindowSec`, resend after `otp.resendAfterSec`, block for `otp.blockSec`); then the server sends a new code in the `Accept-Language` language. A blocked phone or a running resend countdown answers 200 with `allowed: false` and sends nothing. A number the channel cannot reach answers 422 `OTP_DELIVERY_FAILED` (the request still counts). A channel outage answers 503 `INTERNAL`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"string\",\n  \"purpose\": \"LOGIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Check the typed code and get an otpToken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/v1/auth/otp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer",
                "v1",
                "auth",
                "otp",
                "verify"
              ],
              "query": [],
              "variable": []
            },
            "description": "Public. The right code (for this phone and purpose) is used up and answers `otpToken`. Errors: 401 `OTP_INVALID` (wrong code; `details[0].message` says how many attempts are left; the last wrong code blocks), 401 `OTP_EXPIRED` (no code, expired or already used: request a new one), 429 `OTP_BLOCKED`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"string\",\n  \"purpose\": \"LOGIN\",\n  \"code\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Check a number before sending the OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/v1/auth/check-phone",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer",
                "v1",
                "auth",
                "check-phone"
              ],
              "query": [],
              "variable": []
            },
            "description": "LOGIN: 404 `PHONE_NOT_REGISTERED`, 403 `ACCOUNT_BLOCKED`. REGISTER: 409 `PHONE_ALREADY_REGISTERED`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"string\",\n  \"purpose\": \"LOGIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log in with an otpToken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer",
                "v1",
                "auth",
                "login"
              ],
              "query": [],
              "variable": []
            },
            "description": "`otpToken` = the single-use proof from `POST /auth/otp/verify` (purpose LOGIN) for this phone. Errors: `OTP_INVALID`, `OTP_EXPIRED` (401), `OTP_BLOCKED` (429), `ACCOUNT_BLOCKED` (403), `PHONE_NOT_REGISTERED` (404).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"string\",\n  \"otpToken\": \"string\",\n  \"pushToken\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register with an otpToken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer",
                "v1",
                "auth",
                "register"
              ],
              "query": [],
              "variable": []
            },
            "description": "Creates the account and signs it in. `otpToken` from `POST /auth/otp/verify` (purpose REGISTER), single use. Errors: `OTP_INVALID`, `OTP_EXPIRED`, `OTP_BLOCKED`, `PHONE_ALREADY_REGISTERED` (409).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"string\",\n  \"email\": \"string\",\n  \"phone\": \"string\",\n  \"otpToken\": \"string\",\n  \"pushToken\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Rotate the refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer",
                "v1",
                "auth",
                "refresh"
              ],
              "query": [],
              "variable": []
            },
            "description": "Returns a new access and refresh token. Reusing an old refresh token ends every session of that login (401).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customer",
                "v1",
                "auth",
                "logout"
              ],
              "query": [],
              "variable": []
            },
            "description": "Revokes the refresh token and forgets the device push token. Always succeeds for well-formed tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Change the phone number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{language}}"

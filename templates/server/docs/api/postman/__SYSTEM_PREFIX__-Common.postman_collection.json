              },
              {
                "key": "x-signature",
                "value": ""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhooks/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "payments"
              ],
              "query": [],
              "variable": []
            },
            "description": "The gateway signs the exact body; the signature travels in the `x-signature` header. Unverifiable calls answer 401 and change nothing; replays are acknowledged without a second effect.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }

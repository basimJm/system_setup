# Keys only. Real values live in .env.development / .env.production (never committed).
# Every key read by src/config must be listed here (checked by tests/config.test.ts).
NODE_ENV=
PORT=
LOG_LEVEL=
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=
MONGODB_URI=
REDIS_URL=
JWT_ACCESS_SECRET=
# Optional: base64 of 32 random bytes (openssl rand -base64 32) for fields encrypted at rest.
FIELD_ENCRYPTION_KEY=
# Providers: fake (in-repo stand-in, dev/test only) or real (the __NPM_SCOPE__/<sdk> adapter in
# src/providers/<name>/real.ts). Production must name real for every provider; payments may be disabled.
OTP_PROVIDER=
STORAGE_PROVIDER=
NOTIFIER_PROVIDER=
PAYMENT_PROVIDER=
ANALYTICS_PROVIDER=
# Phone OTP: HMAC secrets (>= 32 characters, different; openssl rand -base64 48). Required for real;
# the fake provider makes per-process secrets when they are unset. OTP_FIXED_CODE (dev only,
# refused in production) makes every code that value so local QA can sign in.
OTP_CODE_SECRET=
OTP_PROOF_SECRET=
OTP_FIXED_CODE=
# Development data: true runs the idempotent `seed:dev` after startup (never in production).
SEED_DEV_ON_START=

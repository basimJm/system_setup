{
  "kind": "server",
  "description": "Backend API template (Node 22 + Express 5 + Mongoose + Redis + Socket.IO + BullMQ, TypeScript strict): one namespace per audience of the plan (an end-user one and a staff one, named after the plan's modules; the template ships them as `customer` and `merchant`) next to /admin/v1 with phone-OTP and admin email+password+email-OTP auth, JWT access + rotating refresh tokens, settings registry, append-only audit, notifications, uploads, provider ports with fakes, OpenAPI + Postman generation with a contract guard, Docker, seeds and one sample `items` feature per audience.",
  "placeholders": [
    "__SYSTEM_NAME__",
    "__SYSTEM_NAME_AR__",
    "__SYSTEM_SLUG__",
    "__SYSTEM_PREFIX__",
    "__PACKAGE_ROOT__",
    "__NPM_SCOPE__",
    "__SERVER_DIR__",
    "__ADMIN_DIR__",
    "__DEV_API_URL__",
    "__PROD_API_URL__",
    "__OWNER_GITHUB__",
    "__REPO_NAME__",
    "__YEAR__"
  ],
  "sentinels": {},
  "rename_paths": {
    "__SYSTEM_PREFIX__": "__SYSTEM_PREFIX__"
  },
  "skip": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "TEMPLATE.json"
  ],
  "post_generate": [
    "npm ci",
    "npm run contract:init",
    "npm run docs",
    "npm run format",
    "npm run verify"
  ],
  "binary_globs": [],
  "audiences": {
    "end_user": {
      "word": "customer",
      "plural": "customers"
    },
    "staff": {
      "word": "merchant",
      "plural": "merchants"
    }
  },
  "prune": {
    "staff": {
      "skip": [
        "src/modules/merchant/**",
        "tests/merchantAuth.test.ts",
        "docs/api/openapi.merchant.json",
        "docs/api/postman/__SYSTEM_PREFIX__-Merchant.postman_collection.json"
      ],
      "edits": [
        {
          "file": "src/constants/docs.ts",
          "find": "['common', 'customer', 'merchant', 'admin']",
          "replace_with": "['common', 'customer', 'admin']"
        },
        {
          "file": "src/modules/shared/otp/index.ts",
          "find": "CUSTOMER_OTP_SCHEMAS, MERCHANT_OTP_SCHEMAS,",
          "replace_with": "CUSTOMER_OTP_SCHEMAS,"
        },
        {
          "file": "src/modules/shared/otp/otp.openapi.ts",
          "find": "CUSTOMER_OTP_SCHEMAS, MERCHANT_OTP_SCHEMAS,",
          "replace_with": "CUSTOMER_OTP_SCHEMAS,"
        },
        {
          "file": "tests/docs.test.ts",
          "find": "['customer', 'merchant', 'admin'] as const",
          "replace_with": "['customer', 'admin'] as const"
        },
        {
          "file": "src/routes/index.ts",
          "find": "Readonly<Record<ApiNamespace, Router>>",
          "replace_with": "Readonly<Record<Exclude<ApiNamespace, 'merchant'>, Router>>"
        },
        {
          "file": "tests/devSeed.test.ts",
          "find": "DEV_SEED.items.length * 2",
          "replace_with": "DEV_SEED.items.length"
        },
        {
          "file": "tests/phoneOtp.test.ts",
          "find": "['customer', 'merchant']",
          "replace_with": "['customer']"
        }
      ],

<?xml version="1.0" encoding="UTF-8"?>
<!-- Android Lint policy (CLAUDE.md §1.7): warnings are errors. Security, performance, RTL and i18n stay on. -->
<lint>
    <!-- Time-dependent checks would break CI without any code change. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="OldTargetApi" severity="informational" />

    <!-- FCM 26: the token arrives in onRegistered(); onNewToken() is deprecated, so this check no longer applies. -->
    <issue id="MissingFirebaseInstanceTokenRefresh" severity="ignore" />

    <!-- Always errors: missing Arabic/English text, RTL support, hardcoded text, security. -->
    <issue id="MissingTranslation" severity="error" />
    <issue id="ExtraTranslation" severity="error" />
    <issue id="HardcodedText" severity="error" />
    <issue id="RtlHardcoded" severity="error" />
    <issue id="RtlEnabled" severity="error" />
    <issue id="AllowBackup" severity="error" />
    <issue id="ExportedService" severity="error" />
    <issue id="UnsafeIntentLaunch" severity="error" />
    <issue id="TrustAllX509TrustManager" severity="error" />
    <issue id="SetJavaScriptEnabled" severity="error" />
    <issue id="HardcodedDebugMode" severity="error" />
</lint>

# __SYSTEM_NAME__ Admin: public, non-secret build-time values.
# Copy to .env.dev or .env.prod. Real environment variables override the file.
# Never put secrets here: everything below is shipped to the browser.
# Keep this list equal to ENV_KEYS (src/constants/env.ts) and the zod schema: `npm run check:env`.
#
# dev-debug (`npm run dev`): mock data source, the default; set VITE_DATA_SOURCE=remote to use the API.
# dev-release, prod-debug, prod-release: remote data source only, both URLs required (https for prod).
# `.env.dev` / `.env.prod` are committed with PLACEHOLDER base URLs (public values only): replace them.

# Base URL of the __SERVER_DIR__ API, without a trailing path. Required for the remote source.
# Example: https://api.example.com
VITE_API_BASE_URL=

# Origin of the Socket.IO server (realtime invalidations, alerts). Required for the remote source.
# Example: https://api.example.com
VITE_SOCKET_URL=

# `mock` (dev only) or `remote`. Empty = mock in dev, remote in prod.
VITE_DATA_SOURCE=

# `ar` or `en`. Empty = ar. Only the first-visit default; the user's choice is remembered.
VITE_DEFAULT_LANGUAGE=

# Build machine only (not a VITE_ key, never read at runtime): BUILD_ID overrides the git sha shown
# on the /about page, for builds outside a git checkout.
